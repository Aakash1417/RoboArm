<mujoco model="so101_tabletop">
  <!-- Official SO-101 model from TheRobotStudio/SO-ARM100 (Simulation/SO101). -->
  <include file="so101_new_calib.xml"/>

  <option timestep="0.002"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="180" elevation="-25" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
             rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <texture type="2d" name="wood" builtin="flat" rgb1="0.55 0.40 0.27" width="64" height="64"/>
    <material name="tabletop" texture="wood" rgba="0.75 0.6 0.45 1"/>
    <material name="leg" rgba="0.25 0.2 0.15 1"/>
  </asset>

  <worldbody>
    <light pos="0.3 0.3 1.5" dir="-0.2 -0.2 -1" directional="false" castshadow="true"/>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true" castshadow="false" diffuse="0.4 0.4 0.4"/>

    <!-- Floor is 0.75 m below the table top. The robot base sits at the world origin on the table. -->
    <geom name="floor" size="0 0 0.05" pos="0 0 -0.75" type="plane" material="groundplane"/>
    <geom name="table" type="box" pos="0.15 0 -0.02" size="0.35 0.45 0.02" material="tabletop"
          contype="1" conaffinity="3" friction="1 0.005 0.0001"/>
    <geom type="box" pos="-0.15 0.40 -0.39" size="0.025 0.025 0.35" material="leg" contype="0" conaffinity="0"/>
    <geom type="box" pos="-0.15 -0.40 -0.39" size="0.025 0.025 0.35" material="leg" contype="0" conaffinity="0"/>
    <geom type="box" pos="0.45 0.40 -0.39" size="0.025 0.025 0.35" material="leg" contype="0" conaffinity="0"/>
    <geom type="box" pos="0.45 -0.40 -0.39" size="0.025 0.025 0.35" material="leg" contype="0" conaffinity="0"/>

    <!-- Optional cube to push or grab. -->
    <body name="cube" pos="0.22 0.08 0.015">
      <freejoint name="cube_free"/>
      <geom name="cube" type="box" size="0.015 0.015 0.015" rgba="0.2 0.6 0.9 1" mass="0.03"
            contype="1" conaffinity="3" friction="1.5 0.01 0.001" condim="4"/>
    </body>

    <!-- Visual-only marker that shows where the IK target (hand-controlled point) is. -->
    <body name="target" mocap="true" pos="0.2 0 0.15">
      <geom type="sphere" size="0.012" rgba="1 0.2 0.2 0.45" contype="0" conaffinity="0" group="1"/>
    </body>
  </worldbody>
</mujoco>
